---
import '@fontsource-variable/fraunces';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/events/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true }
);

const monthNames = [
  'january', 'february', 'march', 'april', 'may', 'june',
  'july', 'august', 'september', 'october', 'november', 'december',
];

const datedNamePattern = /^([a-z]+)[-_\s]+(\d{1,2})[-_\s]+(\d{4})(?:[-_\s]+(.+))?$/i;

const toTitleCase = (slug: string) =>
  slug
    .replace(/\s*\(\d+\)$/, '')
    .split(/[-_\s]+/)
    .filter(Boolean)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');

const parseEventName = (baseName: string) => {
  const nameMatch = baseName.match(datedNamePattern);
  const monthIndex = nameMatch ? monthNames.indexOf(nameMatch[1].toLowerCase()) : -1;
  const dayNumber = nameMatch ? Number(nameMatch[2]) : 0;

  if (!nameMatch || monthIndex === -1 || dayNumber < 1 || dayNumber > 31) {
    return { title: toTitleCase(baseName), dateLabel: '', monthShort: '', dayNumber: 0, sortKey: '' };
  }

  const yearNumber = Number(nameMatch[3]);
  const monthName = monthNames[monthIndex];
  const monthLabel = monthName.charAt(0).toUpperCase() + monthName.slice(1);

  return {
    title: nameMatch[4] ? toTitleCase(nameMatch[4]) : 'Event',
    dateLabel: `${monthLabel} ${dayNumber}, ${yearNumber}`,
    monthShort: monthLabel.slice(0, 3),
    dayNumber,
    sortKey: `${yearNumber}${String(monthIndex + 1).padStart(2, '0')}${String(dayNumber).padStart(2, '0')}`,
  };
};

const unsortedEntries = await Promise.all(
  Object.entries(imageModules).map(async ([filePath, imageModule]) => {
    const fileName = filePath.split('/').pop() ?? '';
    const baseName = fileName.replace(/\.[^.]+$/, '');
    const { title, dateLabel, monthShort, dayNumber, sortKey } = parseEventName(baseName);

    const imageMetadata = imageModule.default;
    const enlargedImage = await getImage({
      src: imageMetadata,
      width: Math.min(1080, imageMetadata.width),
    });

    return {
      title,
      dateLabel,
      monthShort,
      dayNumber,
      sortKey,
      imageMetadata,
      enlargedSrc: enlargedImage.src,
      altText: dateLabel ? `${title} event poster, ${dateLabel}` : `${title} event poster`,
    };
  })
);

const eventEntries = unsortedEntries.sort(
  (firstEntry, secondEntry) =>
    secondEntry.sortKey.localeCompare(firstEntry.sortKey) ||
    firstEntry.title.localeCompare(secondEntry.title)
);
---

<BaseLayout title="News/Events">
  <PageHeader
    title="News/Events"
    subtitle="Upcoming gatherings, community events, and highlights from the center."
    eyebrow="Stay Connected"
  />

  <section class="eventsFeedSection">
    <div class="backgroundDots" aria-hidden="true"></div>
    {
      eventEntries.length === 0 ? (
        <p class="emptyMessage">No events yet. Check back soon.</p>
      ) : (
        <div class="posterColumn" id="eventsFeed">
          {eventEntries.map((eventEntry, eventIndex) => (
            <article class="posterCard">
              <div class="posterFrame">
                <button
                  type="button"
                  class="posterButton"
                  data-full-src={eventEntry.enlargedSrc}
                  data-alt={eventEntry.altText}
                  aria-label={`Enlarge ${eventEntry.title} poster`}
                >
                  <Image
                    src={eventEntry.imageMetadata}
                    alt={eventEntry.altText}
                    class="posterImage"
                    widths={[480, 840, 1080]}
                    sizes="(max-width: 600px) 100vw, 560px"
                    loading={eventIndex === 0 ? 'eager' : 'lazy'}
                  />
                </button>
              </div>
              <div class="posterCaption">
                {eventEntry.monthShort && (
                  <div class="dateTile" aria-hidden="true">
                    <span class="dateTileMonth">{eventEntry.monthShort}</span>
                    <span class="dateTileDay">{eventEntry.dayNumber}</span>
                  </div>
                )}
                <div class="posterCaptionText">
                  <h2 class="posterTitle">{eventEntry.title}</h2>
                  {eventEntry.dateLabel && <p class="posterDate">{eventEntry.dateLabel}</p>}
                </div>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </section>

  <section class="closingBanner">
    <h2>Want to be part of what's next?</h2>
    <p>Volunteer, attend an event, or partner with us.</p>
    <a class="bannerButton" href={`${baseUrl}/get-involved/`}>Get involved</a>
  </section>

  <dialog class="lightbox" id="lightbox">
    <button type="button" class="lightboxClose" id="lightboxClose" aria-label="Close enlarged poster">×</button>
    <img class="lightboxImage" id="lightboxImage" alt="" />
  </dialog>
</BaseLayout>

<script>
  const lightbox = document.getElementById('lightbox') as HTMLDialogElement | null;
  const lightboxImage = document.getElementById('lightboxImage') as HTMLImageElement | null;
  const lightboxClose = document.getElementById('lightboxClose');
  const posterButtons = document.querySelectorAll<HTMLButtonElement>('.posterButton');

  posterButtons.forEach((posterButton) => {
    posterButton.addEventListener('click', () => {
      if (!lightbox || !lightboxImage) return;
      lightboxImage.src = posterButton.dataset.fullSrc ?? '';
      lightboxImage.alt = posterButton.dataset.alt ?? '';
      lightbox.showModal();
    });
  });

  lightboxClose?.addEventListener('click', () => lightbox?.close());

  lightbox?.addEventListener('click', (clickEvent) => {
    if (clickEvent.target === lightbox) lightbox.close();
  });

  const eventsFeed = document.getElementById('eventsFeed');
  const posterCards = document.querySelectorAll('.posterCard');

  if (eventsFeed && 'IntersectionObserver' in window) {
    eventsFeed.classList.add('revealReady');

    const revealObserver = new IntersectionObserver(
      (observedEntries, activeObserver) => {
        observedEntries.forEach((observedEntry) => {
          if (observedEntry.isIntersecting) {
            observedEntry.target.classList.add('isVisible');
            activeObserver.unobserve(observedEntry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    posterCards.forEach((posterCard) => revealObserver.observe(posterCard));
  }
</script>

<style>
  .eventsFeedSection {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    margin-top: -64px;
    padding: calc(4rem + 64px) 1.5rem 5rem;
    background: linear-gradient(180deg, #c9f0e1 0%, #ffffff 50%, #c9f0e1 100%);
  }
  :global(.demoBanner),
  :global(.siteFooter) {
    position: relative;
    z-index: 1;
  }
  .backgroundDots {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(circle 70px at 6% 14%, rgba(31, 181, 143, 0.5) 98%, transparent 100%),
      radial-gradient(circle 34px at 24% 7%, rgba(15, 76, 58, 0.45) 98%, transparent 100%),
      radial-gradient(circle 54px at 90% 10%, rgba(47, 125, 109, 0.5) 98%, transparent 100%),
      radial-gradient(circle 30px at 77% 26%, rgba(52, 217, 163, 0.55) 98%, transparent 100%),
      radial-gradient(circle 42px at 4% 42%, rgba(124, 196, 180, 0.7) 98%, transparent 100%),
      radial-gradient(circle 76px at 94% 48%, rgba(31, 181, 143, 0.4) 98%, transparent 100%),
      radial-gradient(circle 56px at 13% 68%, rgba(47, 125, 109, 0.45) 98%, transparent 100%),
      radial-gradient(circle 36px at 85% 72%, rgba(185, 245, 221, 0.9) 98%, transparent 100%),
      radial-gradient(circle 62px at 7% 90%, rgba(15, 76, 58, 0.4) 98%, transparent 100%),
      radial-gradient(circle 28px at 31% 95%, rgba(52, 217, 163, 0.55) 98%, transparent 100%),
      radial-gradient(circle 48px at 92% 93%, rgba(124, 196, 180, 0.7) 98%, transparent 100%),
      radial-gradient(circle 26px at 68% 5%, rgba(31, 181, 143, 0.5) 98%, transparent 100%);
  }
  .emptyMessage {
    position: relative;
    z-index: 1;
    text-align: center;
    color: var(--colorMuted);
    margin: 2rem 0;
  }
  .posterColumn {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5.5rem;
    max-width: 560px;
    margin: 0 auto;
  }
  .posterCard {
    position: relative;
    isolation: isolate;
    width: 100%;
  }
  .posterCard::before {
    content: '';
    position: absolute;
    inset: -180px -260px;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse closest-side,
      var(--glowInner) 0%,
      var(--glowInner) 55%,
      var(--glowOuter) 78%,
      transparent 100%
    );
  }
  .posterCard:nth-child(4n + 1) {
    --glowInner: rgba(31, 181, 143, 0.85);
    --glowOuter: rgba(47, 125, 109, 0.35);
  }
  .posterCard:nth-child(4n + 2) {
    --glowInner: rgba(52, 217, 163, 0.8);
    --glowOuter: rgba(31, 181, 143, 0.35);
  }
  .posterCard:nth-child(4n + 3) {
    --glowInner: rgba(47, 125, 109, 0.85);
    --glowOuter: rgba(124, 196, 180, 0.4);
  }
  .posterCard:nth-child(4n + 4) {
    --glowInner: rgba(15, 76, 58, 0.75);
    --glowOuter: rgba(31, 181, 143, 0.35);
  }
  .posterColumn.revealReady .posterCard:not(.isVisible) {
    opacity: 0;
    transform: translateY(28px);
  }
  .posterColumn.revealReady .posterCard {
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .posterFrame {
    padding: 8px;
    border-radius: 24px;
    background: conic-gradient(
      from 200deg,
      #0f4c3a,
      #1fb58f,
      #b9f5dd,
      #ffffff,
      #7cc4b4,
      #2f7d6d,
      #0f4c3a
    );
    box-shadow: 0 18px 44px rgba(15, 76, 58, 0.4);
  }
  .posterButton {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    border-radius: 16px;
    overflow: hidden;
    background: none;
    cursor: zoom-in;
  }
  .posterButton:focus-visible {
    outline: 3px solid var(--colorText);
    outline-offset: 3px;
  }
  .posterImage {
    display: block;
    width: 100%;
    height: auto;
  }
  .posterCaption {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: calc(100% - 2.5rem);
    margin: -12px auto 0;
    padding: 0.9rem 1.1rem;
    border-radius: 16px;
    background: #ffffff;
    box-shadow: 0 10px 26px rgba(15, 76, 58, 0.25);
    text-align: left;
  }
  .dateTile {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 68px;
    border-radius: 14px;
    color: #ffffff;
    background: linear-gradient(160deg, #0f4c3a, #1fb58f);
    box-shadow: 0 6px 14px rgba(15, 76, 58, 0.35);
  }
  .dateTileMonth {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
  }
  .dateTileDay {
    font-family: 'Fraunces Variable', Georgia, 'Times New Roman', serif;
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1.05;
  }
  .posterTitle {
    margin: 0;
    font-family: 'Fraunces Variable', Georgia, 'Times New Roman', serif;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
    color: #0d2f27;
  }
  .posterDate {
    margin: 0.3rem 0 0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--colorPrimaryDark);
  }
  .closingBanner {
    position: relative;
    z-index: 1;
    padding: 3.5rem 1.5rem;
    text-align: center;
    color: #ffffff;
    background: linear-gradient(135deg, #0f4c3a, #2f7d6d 55%, #1fb58f);
  }
  .closingBanner h2 {
    margin: 0 0 0.5rem;
  }
  .closingBanner p {
    margin: 0 0 1.5rem;
  }
  .bannerButton {
    display: inline-block;
    padding: 0.7rem 1.5rem;
    border-radius: 999px;
    background: #ffffff;
    color: #0f4c3a;
    font-weight: 600;
    text-decoration: none;
  }
  .lightbox {
    padding: 0;
    border: none;
    background: transparent;
    max-width: 95vw;
    max-height: 95vh;
    overflow: visible;
  }
  .lightbox::backdrop {
    background: rgba(0, 0, 0, 0.82);
  }
  .lightboxImage {
    display: block;
    max-width: 90vw;
    max-height: 90vh;
    width: auto;
    height: auto;
    border-radius: 12px;
  }
  .lightboxClose {
    position: absolute;
    top: -0.5rem;
    right: -0.5rem;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 50%;
    background: #ffffff;
    color: var(--colorText);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    z-index: 1;
  }
  :global(body:has(.lightbox[open])) {
    overflow: hidden;
  }
  @media (max-width: 600px) {
    .eventsFeedSection {
      margin-top: -44px;
      padding: calc(2.5rem + 44px) 1rem 3.5rem;
    }
    .posterColumn {
      gap: 4.5rem;
    }
    .posterCaption {
      width: calc(100% - 1.5rem);
      gap: 0.8rem;
      padding: 0.75rem 0.9rem;
    }
    .dateTile {
      width: 54px;
      height: 58px;
    }
    .dateTileDay {
      font-size: 1.55rem;
    }
    .posterTitle {
      font-size: 1.15rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .posterColumn.revealReady .posterCard {
      transition: none;
    }
  }
</style>